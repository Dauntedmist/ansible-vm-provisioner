external_url '{{ gitlab_external_url }}'

# Fixes the 'ValueError: Type gitlab_shell_t is invalid'
# Even in Permissive mode, this prevents Chef from trying to label files
gitlab_rails['selinux_enabled'] = {{ gitlab_selinux_enabled | lower }}

# Add environment-specific SSL logic
{% if gitlab_ssl_certificate is defined %}
nginx['redirect_http_to_https'] = true
nginx['ssl_certificate'] = "{{ gitlab_ssl_certificate }}"
nginx['ssl_certificate_key'] = "{{ gitlab_ssl_certificate_key }}"
{% endif %}